---
// Base.astro — shared page shell.
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE_URL } from "../config/site";
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  stickyCta?: boolean;
  /** Trail below Home, e.g. [{ name: "Communities", href: "/communities/" }, { name: "Erda", href: "/communities/erda/" }]. */
  breadcrumbs?: { name: string; href: string }[];
}
const { title, description, canonical, ogImage, type, stickyCta = false, breadcrumbs } = Astro.props;
const trail = breadcrumbs ? [{ name: "Home", href: "/" }, ...breadcrumbs] : null;
const breadcrumbSchema = trail && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: trail.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: `${SITE_URL}${c.href}` })),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo title={title} description={description} canonical={canonical} ogImage={ogImage} type={type} />
    {breadcrumbSchema && <JsonLd data={breadcrumbSchema} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-2 focus:left-2 focus:bg-white focus:text-ink focus:px-4 focus:py-2 focus:rounded-lg focus:border focus:border-hairline">Skip to content</a>
    <Header />
    <main id="main">
      {trail && (
        <nav aria-label="Breadcrumb" class="bg-paper text-ink">
          <ol class="w-[min(100%,72rem)] mx-auto px-5 pt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[.82rem] text-muted">
            {trail.map((c, i) => (
              <li class="flex items-center gap-2">
                {i > 0 && <span aria-hidden="true">/</span>}
                {i < trail.length - 1 ? (
                  <a href={c.href} class="underline underline-offset-2 hover:text-ink">{c.name}</a>
                ) : (
                  <span aria-current="page" class="text-ink">{c.name}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyCta />}
    <script>
      // First-touch attribution for the lead form: utm_* from the URL, the referrer and the landing page,
      // kept in sessionStorage for this visit only. Nothing is sent anywhere until a form is submitted.
      try {
        const KEY = "ldt_attr";
        if (!sessionStorage.getItem(KEY)) {
          const q = new URLSearchParams(location.search);
          const a: Record<string, string> = {};
          for (const k of ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term"]) {
            const v = q.get(k);
            if (v) a[k] = v.slice(0, 120);
          }
          if (q.has("fbclid") && !a.utm_source) a.utm_source = "facebook";
          if (document.referrer) a.ref = document.referrer.slice(0, 300);
          a.landing = (location.pathname + location.search).slice(0, 300);
          sessionStorage.setItem(KEY, JSON.stringify(a));
        }
      } catch {}
    </script>
  </body>
</html>
