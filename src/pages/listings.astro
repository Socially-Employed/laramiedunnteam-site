---
// listings.astro — index of every active team listing, fed by src/content/listings.ts (generated from URE's
// public listing pages for our own listings). Nothing here is hand-typed; regenerate the content file to update.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import ListingCard from "../components/ListingCard.astro";
import Icon from "../components/Icon.astro";
import { COUNTY } from "../config/site";
import { LISTINGS, photoOf, fmtPrice, UPDATED, statusLabel } from "../content/listings";

const homes = LISTINGS.filter((l) => l.kind !== "Land");
const land = LISTINGS.filter((l) => l.kind === "Land");
const card = (l: (typeof LISTINGS)[number]) => ({
  address: l.address,
  city: `${l.city}, UT`,
  price: fmtPrice(l.price),
  beds: l.beds ?? undefined,
  baths: l.baths ?? undefined,
  status: statusLabel(l),
  image: l.photos[0] ? photoOf(l, l.photos[0], "640x480") : undefined,
  href: l.href,
});
const towns = [...new Set(LISTINGS.map((l) => l.city))].join(", ");
---
<Base
  breadcrumbs={[{ name: "Listings", href: "/listings/" }]}
  title="Listings · Laramie Dunn Team"
  description={`Every active listing from the Laramie Dunn Team in ${COUNTY}: ${LISTINGS.length} homes and lots in ${towns}, with photos, details, and showing requests.`}
  stickyCta={true}
>
  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Listings</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)]">Our listings</h1>
    <p class="mt-4 text-lg leading-relaxed max-w-[640px]">Everything we have on the market right now in {towns}. {LISTINGS.length} listings, updated {UPDATED}.</p>
  </Section>

  <Section tone="white" labelledby="homes-h">
    <h2 id="homes-h" class="text-[clamp(1.4rem,5vw,1.8rem)]">Homes for sale</h2>
    <p class="mt-2 text-muted max-w-[640px]">Includes new construction with Heritage Homes in Grantsville and Erda. "To be built" homes can still be customized; "under construction" homes have a completion date in sight.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {homes.map((l) => <ListingCard listing={card(l)} />)}
    </div>
  </Section>

  {land.length > 0 && (
    <Section tone="paper" labelledby="land-h">
      <h2 id="land-h" class="text-[clamp(1.4rem,5vw,1.8rem)]">Land</h2>
      <p class="mt-2 text-muted max-w-[640px]">Acreage in Pine Canyon for a custom build, with views and room for horses.</p>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {land.map((l) => <ListingCard listing={card(l)} />)}
      </div>
    </Section>
  )}

  <Section tone="white" narrow>
    <div class="rounded-[16px] border border-hairline bg-paper p-6">
      <h2 class="text-[1.3rem] font-display">Looking for something we don't have listed?</h2>
      <p class="mt-2 text-muted">We can help you find and tour homes across {COUNTY}, not just our own listings. Tell us what you're after and we'll go looking.</p>
      <div class="mt-4"><Button href="/contact/" variant="primary">Tell us what you want <Icon name="arrow-right" size={16} /></Button></div>
    </div>
  </Section>
</Base>
