---
// listings.astro — index. 521 (active) + Sagewood (showcase / previously marketed).
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import ListingCard from "../components/ListingCard.astro";
import Icon from "../components/Icon.astro";
import { COUNTY } from "../config/site";

const heroPhoto = "https://assets.utahrealestate.com/photos/640x480/2135169_871b90f3a3f3c9ddd9700724b179b692_6a60eedf29d38.jpg";
---
<Base
  title="Listings · Laramie Dunn Team"
  description="Current and previously marketed listings from the Laramie Dunn Team in Tooele County, Utah, including 521 E Gilmour St in Grantsville."
  stickyCta={true}
>
  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Listings</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)]">Our listings</h1>
    <p class="mt-4 text-lg leading-relaxed max-w-[640px]">What we have on the market now, plus recent work that shows how we market a home.</p>
  </Section>

  <Section tone="white" labelledby="active-h">
    <h2 id="active-h" class="text-[clamp(1.4rem,5vw,1.8rem)]">For sale now</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <ListingCard listing={{
        address: "521 E Gilmour St",
        city: "Grantsville, UT",
        price: "$1,299,000",
        beds: 7,
        baths: 5,
        status: "For sale",
        image: heroPhoto,
        href: "/listings/521-e-gilmour-st-grantsville/",
      }} />
    </div>
  </Section>

  <Section tone="paper" labelledby="showcase-h">
    <h2 id="showcase-h" class="text-[clamp(1.4rem,5vw,1.8rem)]">Marketing showcase</h2>
    <p class="mt-2 text-muted max-w-[640px]">Previously marketed homes we produced video packages for — samples of our work, not homes currently for sale.</p>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <Card>
        <span class="inline-block px-2.5 py-1 rounded-full bg-hairline text-ink text-[.7rem] font-bold uppercase tracking-[.05em]">Previously marketed</span>
        <p class="mt-3 font-display text-[1.35rem] text-copper-dark">$485,000</p>
        <p class="mt-1 font-semibold text-ink">5673 N Sagewood Dr</p>
        <p class="text-muted text-[.9rem]">Stansbury Park, UT</p>
        <p class="mt-3 text-[.9rem] text-muted">4 bd · 4 ba · 2,579 sqft · built 2022 · MLS# 2151309</p>
        <p class="mt-3 text-[.9rem]"><a href="/sell/#video" class="text-copper-dark no-underline hover:underline">See our video package →</a></p>
      </Card>
    </div>
  </Section>

  <Section tone="white" narrow>
    <div class="rounded-[16px] border border-hairline bg-paper p-6">
      <h2 class="text-[1.3rem] font-display">Looking for something we don't have listed?</h2>
      <p class="mt-2 text-muted">We can help you find and tour homes across {COUNTY}, not just our own listings. Tell us what you're after and we'll go looking.</p>
      <div class="mt-4"><Button href="/contact/" variant="primary">Tell us what you want <Icon name="arrow-right" size={16} /></Button></div>
    </div>
  </Section>
</Base>
