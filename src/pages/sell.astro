---
// sell.astro — sellers. Process, pricing, prep, and the video package showcase (521 tour + Sagewood sample).
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import LeadForm from "../components/LeadForm.astro";
import YouTubeEmbed from "../components/YouTubeEmbed.astro";
import Icon from "../components/Icon.astro";

const steps = [
  { n: "1", h: "Pricing conversation", b: "We look at what's actually selling near you and talk through a price that fits the home and the market — not a number picked to win the listing." },
  { n: "2", h: "Prep and repairs", b: "We tell you what's worth doing before you list and what isn't. Sometimes the honest answer is 'leave it.'" },
  { n: "3", h: "The video package", b: "Every listing gets a professional video package, so your home is shown well online from the day it lists." },
  { n: "4", h: "Go live and show", b: "We put it in front of buyers, manage showings, and keep you posted on what we're hearing." },
  { n: "5", h: "Offers and negotiation", b: "We walk through each offer with you and negotiate terms, not just price." },
  { n: "6", h: "Under contract to closing", b: "We manage inspections, appraisal, and deadlines through to the closing table." },
];
---
<Base
  breadcrumbs={[{ name: "Selling", href: "/sell/" }]}
  title="Selling your home in Tooele County"
  description="How selling works with the Laramie Dunn Team — an honest pricing conversation, real prep advice, and a professional video package on every listing."
  stickyCta={true}
>
  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Selling</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)] max-w-[720px]">Selling your home, marketed the way it should be.</h1>
    <p class="mt-4 text-lg leading-relaxed max-w-[680px]">A straight conversation about price, real advice on prep, and professional video behind every listing. Here's how we work when you sell with us.</p>
    <div class="mt-6 flex flex-wrap gap-3"><Button href="#start" variant="primary">Ask for a pricing conversation <Icon name="arrow-right" size={16} /></Button><Button href="/home-value/" variant="ghost">What is my home worth?</Button></div>
  </Section>

  <Section tone="white" labelledby="steps-h">
    <h2 id="steps-h" class="text-[clamp(1.5rem,5vw,2rem)]">The process</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <Card>
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-copper text-white font-display">{s.n}</span>
          <p class="mt-3 font-display text-[1.2rem]">{s.h}</p>
          <p class="mt-2 text-muted text-[.95rem]">{s.b}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="paper" id="video" labelledby="video-h">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">The video package</p>
    <h2 id="video-h" class="mt-2 text-[clamp(1.6rem,6vw,2.2rem)] max-w-[720px]">Professional video on every listing.</h2>
    <p class="mt-3 text-muted max-w-[680px]">We produce a full video package for each home — a walkthrough tour plus short-form cuts sized for social feeds — so your listing is shown well where buyers are looking. Two examples of our work:</p>

    <div class="mt-8 grid gap-8 md:grid-cols-2 md:items-start">
      <div>
        <YouTubeEmbed id="zONayX2K3wI" title="Video tour of 521 E Gilmour St, Grantsville" />
        <p class="mt-3 font-semibold text-ink">521 E Gilmour St, Grantsville</p>
        <p class="text-muted text-[.9rem]">Full video tour of our current Grantsville listing. <a href="/listings/521-e-gilmour-st-grantsville/" class="text-copper-dark underline underline-offset-2 decoration-copper/40 hover:decoration-copper-dark">See the listing</a>.</p>
      </div>
      <div>
        <Card>
          <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Showcase sample</p>
          <p class="mt-2 font-display text-[1.3rem]">5673 N Sagewood Dr, Stansbury Park</p>
          <p class="mt-1 text-muted">$485,000 · 4 bd · 4 ba · 2,579 sqft · built 2022 · MLS# 2151309</p>
          <p class="mt-3 text-[.95rem] text-muted">A previously marketed home we produced a four-format video package for. Shown here as a sample of our marketing work.</p>
        </Card>
      </div>
    </div>
  </Section>

  <Section tone="white" narrow labelledby="pricing-h">
    <h2 id="pricing-h" class="text-[clamp(1.5rem,5vw,2rem)]">The pricing conversation</h2>
    <div class="mt-4 space-y-4 text-[1.02rem] leading-relaxed">
      <p>Pricing is one of the biggest decisions when you sell, and it's easy to get talked into a number that feels good but doesn't hold up. We'd rather show you the recent sales, explain what they mean for your home, and land on a price together.</p>
      <p>If the market says something you don't want to hear, we'll say it anyway. That's the job.</p>
    </div>
  </Section>

  <Section tone="panel" narrow id="start">
    <LeadForm src="sell" heading="Thinking about selling?" intent="sell" button="Talk about selling" />
  </Section>
</Base>
