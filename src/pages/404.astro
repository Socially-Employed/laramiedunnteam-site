---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
---
<Base title="Page not found" description="That page could not be found.">
  <Section tone="paper">
    <p class="font-display text-copper-dark text-[3rem]">404</p>
    <h1 class="mt-2 text-[clamp(1.6rem,6vw,2.2rem)]">We couldn't find that page</h1>
    <p class="mt-3 text-muted max-w-[520px]">The page may have moved. Head back home or browse current listings.</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <Button href="/" variant="primary">Go home</Button>
      <Button href="/listings" variant="ghost">View listings</Button>
    </div>
  </Section>
</Base>
