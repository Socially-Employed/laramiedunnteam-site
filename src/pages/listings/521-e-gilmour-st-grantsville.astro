---
// 521 E Gilmour detail. HARD RULE: never show square footage or garage-stall counts (CONTENT_BRIEF §4).
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import FactStrip from "../../components/FactStrip.astro";
import Button from "../../components/Button.astro";
import LeadForm from "../../components/LeadForm.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import JsonLd from "../../components/JsonLd.astro";
import Icon from "../../components/Icon.astro";
import { SITE_URL } from "../../config/site";

// First 12 photo hashes, MLS listing order (assets.utahrealestate.com, listing 2135169).
const HASHES = [
  "871b90f3a3f3c9ddd9700724b179b692_6a60eedf29d38",
  "b353958f2b24c17f75284a04fb257d9d_6a60f7397392a",
  "76feff6780b58f7da3ed34708045901b_6a60f2bccbaaf",
  "13295ed9fcec57ed43972dfc71d91bdf_6a60f2bab71b6",
  "c764211da4708aadb93c6c03de575fb3_6a60f2bf11465",
  "b4afe050147170d5b1fdcaf7aad66fa3_6a60f648c4af1",
  "b3a5fee44e99cefd6141d06d48fab1eb_6a60f2b43f273",
  "e48b0f0568e232ef146bbe089b059ef8_6a60f2b5eafc5",
  "f821756b125fca82c8f6c169121b5b64_6a60f2b97e796",
  "78775414c5092d366697c66d0e0c0d01_6a60f2b7898bd",
  "23e09686aaa8fc0765bb554cb1cc8ada_6a60f2b0891ac",
  "90c54493f97ef6adacad0702ed55f7c9_6a60f36ab70a6",
];
const thumb = (h: string) => `https://assets.utahrealestate.com/photos/640x480/2135169_${h}.jpg`;
const full = (h: string) => `https://assets.utahrealestate.com/photos/2048x1536/2135169_${h}.jpg`;
const ogPhoto = full(HASHES[0]);
const matterport = "https://my.matterport.com/show/?m=Tvh5ofWoaUd";

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "SingleFamilyResidence",
  name: "521 E Gilmour St, Grantsville, UT",
  url: new URL("/listings/521-e-gilmour-st-grantsville/", SITE_URL).href,
  image: ogPhoto,
  numberOfBedrooms: 7,
  numberOfBathroomsTotal: 5,
  address: {
    "@type": "PostalAddress",
    streetAddress: "521 E Gilmour St",
    addressLocality: "Grantsville",
    addressRegion: "UT",
    postalCode: "84029",
    addressCountry: "US",
  },
  offers: {
    "@type": "Offer",
    price: "1299000",
    priceCurrency: "USD",
    availability: "https://schema.org/InStock",
  },
};
---
<Base
  title="521 E Gilmour St, Grantsville UT"
  description="521 E Gilmour St, Grantsville — a custom estate with 7 bedrooms and a separate-entrance basement apartment. $1,299,000. Tour and pricing here."
  canonical="/listings/521-e-gilmour-st-grantsville/"
  ogImage={ogPhoto}
  type="article"
  stickyCta={true}
>
  <JsonLd slot="head" data={listingSchema} />

  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">For sale · Grantsville</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)]">521 E Gilmour St</h1>
    <p class="mt-1 text-muted text-lg">Heritage Farms · Grantsville, UT 84029</p>
  </Section>

  <FactStrip items={[
    { value: "$1,299,000", label: "Price" },
    { value: "7", label: "Bedrooms" },
    { value: "5", label: "Bathrooms" },
  ]} />

  <Section tone="white" labelledby="gallery-h">
    <h2 id="gallery-h" class="sr-only">Photo gallery</h2>
    <div class="grid gap-3 grid-cols-2 md:grid-cols-3">
      {HASHES.map((h, i) => (
        <a href={full(h)} target="_blank" rel="noopener" class="block overflow-hidden rounded-[12px] border border-hairline bg-hairline">
          <img src={thumb(h)} alt={`Photo ${i + 1} of 521 E Gilmour St, Grantsville`} width="640" height="480" loading="lazy" class="w-full h-full object-cover aspect-[4/3] hover:opacity-95" />
        </a>
      ))}
    </div>
    <p class="mt-3 text-[.8rem] text-muted">Photos courtesy of the listing brokerage. Select a photo to view it larger.</p>
  </Section>

  <Section tone="paper" labelledby="about-h">
    <div class="grid gap-8 md:grid-cols-2 md:items-start">
      <div>
        <h2 id="about-h" class="text-[clamp(1.5rem,5vw,2rem)]">About this home</h2>
        <div class="mt-4 space-y-4 text-[1.02rem] leading-relaxed">
          <p>521 E Gilmour is a custom estate in the Heritage Farms subdivision of Grantsville, built by Heritage Homes and shown as Home #29 in the 2026 Salt Lake Parade of Homes.</p>
          <p>It has seven bedrooms and five bathrooms, and includes a separate-entrance basement apartment — a space that can be used as an income suite. Comparable two-bedroom rentals in Grantsville have recently asked in the range of $1,450 to $1,700 a month.</p>
          <p class="text-[.85rem] text-muted">Listing information deemed reliable but not guaranteed; buyer to verify all figures.</p>
        </div>
      </div>
      <div class="rounded-[16px] border border-hairline bg-white p-6">
        <p class="font-display text-[1.2rem]">Listed by the Laramie Dunn Team</p>
        <p class="mt-1 text-muted text-[.9rem]">RealtyPath LLC (Tooele Valley)</p>
        <p class="mt-4 text-[.95rem]">Builder: Heritage Homes (Brandon Pehrson)</p>
        <div class="mt-5"><Button href="#showing" variant="primary">Request a showing <Icon name="arrow-right" size={16} /></Button></div>
      </div>
    </div>
  </Section>

  <Section tone="white" labelledby="media-h">
    <h2 id="media-h" class="text-[clamp(1.5rem,5vw,2rem)]">Tour it</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-2">
      <div>
        <p class="font-semibold text-ink mb-3">Video tour</p>
        <YouTubeEmbed id="zONayX2K3wI" title="Video tour of 521 E Gilmour St, Grantsville" />
      </div>
      <div>
        <p class="font-semibold text-ink mb-3">3D walkthrough</p>
        <div class="mp-embed relative aspect-video overflow-hidden rounded-[16px] border border-hairline bg-ink" data-embed={matterport} data-title="3D tour of 521 E Gilmour St">
          <button type="button" class="mp-play group absolute inset-0 w-full h-full cursor-pointer border-0 p-0 m-0 flex flex-col items-center justify-center gap-3 text-white" aria-label="Load the 3D walkthrough">
            <span class="flex items-center justify-center w-16 h-16 rounded-full bg-copper text-white shadow-[var(--shadow-lift)]">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
            </span>
            <span class="font-semibold">Load the 3D Matterport tour</span>
          </button>
          <noscript>
            <iframe class="absolute inset-0 w-full h-full" src={matterport} title="3D tour of 521 E Gilmour St" loading="lazy" allow="fullscreen; xr-spatial-tracking" allowfullscreen></iframe>
          </noscript>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="panel" narrow id="showing">
    <LeadForm src="listing-521-gilmour" heading="Request a showing or pricing" intent="buy" />
  </Section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>(".mp-embed").forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>(".mp-play");
    btn?.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.className = "absolute inset-0 w-full h-full";
      iframe.src = box.dataset.embed || "";
      iframe.title = box.dataset.title || "3D tour";
      iframe.allow = "fullscreen; xr-spatial-tracking";
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>
