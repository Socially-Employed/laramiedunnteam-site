---
// Dynamic listing detail page. Fed by src/content/listings.ts (generated from URE's public listing pages for
// our own listings). 521 E Gilmour keeps its hand-built page (video + Matterport); everything else renders here.
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import FactStrip from "../../components/FactStrip.astro";
import Button from "../../components/Button.astro";
import LeadForm from "../../components/LeadForm.astro";
import JsonLd from "../../components/JsonLd.astro";
import Icon from "../../components/Icon.astro";
import ListingCard from "../../components/ListingCard.astro";
import { SITE_URL } from "../../config/site";
import { LISTINGS, photoOf, fmtPrice, UPDATED, statusLabel as labelOf, isUnderContract } from "../../content/listings";

export function getStaticPaths() {
  return LISTINGS.filter((l) => l.mls !== "2135169").map((l) => ({ params: { slug: l.slug }, props: { listing: l } }));
}
const { listing: l } = Astro.props;
const isLand = l.kind === "Land";
const others = LISTINGS.filter((x) => x.mls !== l.mls).slice(0, 3);
const hero = l.photos[0] ? photoOf(l, l.photos[0], "2048x1536") : undefined;
const cityLine = `${l.city}, UT ${l.zip}`;
const facts = [{ value: fmtPrice(l.price), label: "Price" }];
if (l.beds) facts.push({ value: String(l.beds), label: "Bedrooms" });
if (l.baths) facts.push({ value: String(l.baths), label: "Bathrooms" });
if (l.sqft) facts.push({ value: l.sqft.toLocaleString("en-US"), label: "Sq ft" });
if (l.lotAcres) facts.push({ value: l.lotAcres.toFixed(2), label: "Acres" });
const statusLabel = labelOf(l);
const underContract = isUnderContract(l);
const coListed = l.mls !== "2164327" && l.mls !== "2182884"; // the two Pine Canyon lots are Laramie's alone
const schema = {
  "@context": "https://schema.org",
  "@type": isLand ? "RealEstateListing" : "SingleFamilyResidence",
  name: `${l.address}, ${l.city}, UT`,
  url: new URL(l.href, SITE_URL).href,
  ...(hero ? { image: hero } : {}),
  ...(l.beds ? { numberOfBedrooms: l.beds } : {}),
  ...(l.baths ? { numberOfBathroomsTotal: l.baths } : {}),
  address: { "@type": "PostalAddress", streetAddress: l.address, addressLocality: l.city, addressRegion: "UT", postalCode: l.zip, addressCountry: "US" },
  offers: { "@type": "Offer", price: String(l.price), priceCurrency: "USD", availability: underContract ? "https://schema.org/LimitedAvailability" : "https://schema.org/InStock" },
};
const paras = l.remarks.split(/(?<=[.!?])\s+(?=[A-Z])/).reduce<string[]>((acc, s) => {
  const last = acc[acc.length - 1];
  if (last && (last + " " + s).length < 420) acc[acc.length - 1] = last + " " + s; else acc.push(s);
  return acc;
}, []);
---
<Base
  breadcrumbs={[{ name: "Listings", href: "/listings/" }, { name: `${l.address}, ${l.city}`, href: l.href }]}
  title={`${l.address}, ${l.city} UT`}
  description={`${l.address}, ${l.city} — ${isLand ? `${l.lotAcres ? l.lotAcres + " acres" : "land"} for sale` : `${l.beds ?? ""} bed, ${l.baths ?? ""} bath home`} at ${fmtPrice(l.price)}. Photos, details, and showings from the Laramie Dunn Team.`}
  canonical={l.href}
  ogImage={hero}
  type="article"
  stickyCta={true}
>
  <JsonLd slot="head" data={schema} />

  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">{statusLabel} · {l.city}</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)]">{l.address}</h1>
    <p class="mt-1 text-muted text-lg">{cityLine} · MLS# {l.mls}</p>
  </Section>

  <FactStrip items={facts} />

  {l.photos.length > 0 && (
    <Section tone="white" labelledby="gallery-h">
      <h2 id="gallery-h" class="sr-only">Photo gallery</h2>
      <div class="grid gap-3 grid-cols-2 md:grid-cols-3">
        {l.photos.slice(0, 24).map((p, i) => (
          <a href={photoOf(l, p, "2048x1536")} target="_blank" rel="noopener" class="block overflow-hidden rounded-[12px] border border-hairline bg-hairline">
            <img src={photoOf(l, p, "640x480")} alt={p.alt || `Photo ${i + 1} of ${l.address}, ${l.city}`} width="640" height="480" loading={i < 3 ? "eager" : "lazy"} class="w-full h-full object-cover aspect-[4/3] transition-transform group-hover:scale-[1.02]" />
          </a>
        ))}
      </div>
      <p class="mt-3 text-[.8rem] text-muted">
        {l.photos.length > 24 ? `Showing 24 of ${l.photos.length} photos. ` : ""}Photos courtesy of the listing brokerage. Select a photo to view it larger.
        {l.construction ? " Renderings and plan photos may show a representative build; finishes and elevations vary." : ""}
      </p>
    </Section>
  )}

  <Section tone="paper" labelledby="about-h">
    <div class="grid gap-8 md:grid-cols-2 md:items-start">
      <div>
        <h2 id="about-h" class="text-[clamp(1.5rem,5vw,2rem)]">{isLand ? "About this land" : "About this home"}</h2>
        <div class="mt-4 space-y-4 text-[1.02rem] leading-relaxed">
          {paras.map((p) => <p>{p}</p>)}
          {(l.style || l.yearBuilt) && (
            <p class="text-[.95rem] text-muted">
              {l.style ? `${l.style}` : ""}{l.style && l.yearBuilt ? " · " : ""}{l.yearBuilt ? `${l.construction ? "Completion" : "Built"} ${l.yearBuilt}` : ""}
            </p>
          )}
          <p class="text-[.85rem] text-muted">Listing information deemed reliable but not guaranteed; buyer to verify all figures. Updated {UPDATED}.</p>
        </div>
      </div>
      <div class="rounded-[16px] border border-hairline bg-white p-6">
        <p class="font-display text-[1.2rem]">{coListed ? "Listed by Laramie Dunn & Lisa Neil" : "Listing agent: Laramie Dunn"}</p>
        <p class="mt-1 text-muted text-[.9rem]">RealtyPath LLC (Tooele Valley)</p>
        {l.construction && <p class="mt-4 text-[.95rem]">New construction · {l.construction.toLowerCase()}. Ask us about plan options and timelines.</p>}
        {underContract && <p class="mt-4 text-[.95rem]"><span class="inline-block px-2.5 py-1 rounded-full bg-copper-dark text-white text-[.7rem] font-bold uppercase tracking-[.05em]">Under contract</span> <span class="block mt-2">This home is under contract. Ask us about backup offers or similar homes coming up.</span></p>}
        <div class="mt-5"><Button href="#showing" variant="primary">{underContract ? "Ask about this home" : "Request a showing"} <Icon name="arrow-right" size={16} /></Button></div>
        <p class="mt-4 text-[.8rem] text-muted"><a href={l.source} target="_blank" rel="noopener nofollow" class="text-copper-dark no-underline hover:underline">View on UtahRealEstate.com →</a></p>
      </div>
    </div>
  </Section>

  <Section tone="panel" narrow id="showing">
    <LeadForm src={`listing-${l.mls}`} heading="Request a showing or pricing" intent="buy" button="Request a showing" />
  </Section>

  {others.length > 0 && (
    <Section tone="white" labelledby="more-h">
      <h2 id="more-h" class="text-[clamp(1.3rem,5vw,1.7rem)]">More from the team</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((o) => (
          <ListingCard listing={{ address: o.address, city: `${o.city}, UT`, price: fmtPrice(o.price), beds: o.beds ?? undefined, baths: o.baths ?? undefined, status: labelOf(o), image: o.photos[0] ? photoOf(o, o.photos[0], "640x480") : undefined, href: o.href }} />
        ))}
      </div>
    </Section>
  )}
</Base>
