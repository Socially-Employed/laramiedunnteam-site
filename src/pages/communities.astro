---
// communities.astro — hub: photo tiles for each area guide.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import CommunityTile from "../components/CommunityTile.astro";
import { COMMUNITIES, COUNTY_PHOTOS } from "../content/communities";
import { COUNTY } from "../config/site";
---
<Base
  breadcrumbs={[{ name: "Communities", href: "/communities/" }]}
  title="Tooele Valley Communities · Laramie Dunn Team"
  description="Area guides for Grantsville, Stansbury Park, Tooele, Erda, Lake Point, and Stockton, Utah — getting around, housing, and places to visit."
  canonical="/communities/"
>
  <Section tone="paper" labelledby="hub-h">
    <p class="text-copper-dark text-[.78rem] font-semibold uppercase tracking-[.18em]">{COUNTY}</p>
    <h1 id="hub-h" class="mt-2 text-[clamp(1.8rem,5vw,2.6rem)]">The Tooele Valley, town by town</h1>
    <p class="mt-3 max-w-[56ch] text-muted">Plain-language guides to how each town lays out, what the housing looks like, and public places worth knowing. Pick a place, then run a search or ask us.</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {COMMUNITIES.map((c) => <CommunityTile href={`/communities/${c.slug}/`} name={c.name} photo={c.photo} kicker="Area guide" />)}
      <CommunityTile href="/search/" name="Search the whole county" photo={COUNTY_PHOTOS.stansburyIsland} kicker="Run a search" />
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {COMMUNITIES.map((c) => (
        <article class="rounded-[12px] border border-hairline bg-white p-5">
          <h2 class="text-[1.25rem]"><a href={`/communities/${c.slug}/`} class="no-underline text-ink hover:text-copper-dark">{c.name}</a></h2>
          <p class="mt-2 text-muted text-[.95rem]">{c.intro}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 rounded-[12px] bg-ink p-6 md:p-8 text-paper flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="font-display text-[1.4rem] text-white">Trying to choose between towns?</p>
        <p class="mt-1 text-panel-text">Ask us what a commute, a lot size, or a builder is really like.</p>
      </div>
      <Button href="/contact/">Ask the team</Button>
    </div>
  </Section>
</Base>
