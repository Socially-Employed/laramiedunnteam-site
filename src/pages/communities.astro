---
// communities.astro — hub. Links to each neutral community guide.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import { COUNTY } from "../config/site";
import { COMMUNITIES } from "../content/communities";
---
<Base
  breadcrumbs={[{ name: "Communities", href: "/communities/" }]}
  title="Tooele County Communities"
  description="Neutral area guides to the Tooele County, Utah communities the Laramie Dunn Team serves — Grantsville, Stansbury Park, Tooele, Erda, Lake Point, and Stockton."
  stickyCta={true}
>
  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Communities</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)]">The Tooele Valley, town by town</h1>
    <p class="mt-4 text-lg leading-relaxed max-w-[680px]">We work across {COUNTY}. These are plain guides to getting around each town, what the housing looks like, and public places worth knowing — no sales pitch.</p>
  </Section>

  <Section tone="white">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {COMMUNITIES.map((c) => (
        <Card href={`/communities/${c.slug}/`}>
          <Icon name="map-pin" size={24} class="text-copper-dark" />
          <p class="mt-3 font-display text-[1.3rem]">{c.name}</p>
          <p class="mt-2 text-muted text-[.95rem]">{c.intro}</p>
          <p class="mt-4 inline-flex items-center gap-1 text-copper-dark font-semibold text-[.9rem]">Read the guide <Icon name="arrow-right" size={16} /></p>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="paper" narrow>
    <div class="rounded-[16px] border border-hairline bg-white p-6">
      <h2 class="text-[1.3rem] font-display">Trying to choose between towns?</h2>
      <p class="mt-2 text-muted">Tell us how you'd use the place and we'll talk you through the tradeoffs.</p>
      <div class="mt-4"><Button href="/contact/" variant="primary">Talk to us <Icon name="arrow-right" size={16} /></Button></div>
    </div>
  </Section>
</Base>
