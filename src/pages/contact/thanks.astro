---
// contact/thanks.astro — no-JS post-submit landing (Worker 303-redirects here). noindex, excluded from sitemap.
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
import Button from "../../components/Button.astro";
import Icon from "../../components/Icon.astro";
---
<Base
  title="Thanks · Laramie Dunn Team"
  description="Thanks for reaching out to the Laramie Dunn Team. We'll be in touch shortly."
  canonical="/contact/thanks/"
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <Section tone="paper" narrow>
    <div class="text-center py-6">
      <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-copper text-white"><Icon name="check" size={28} /></span>
      <h1 class="mt-5 text-[clamp(1.8rem,6vw,2.4rem)]">Thanks — we got it.</h1>
      <p class="mt-3 text-lg text-muted max-w-[520px] mx-auto">You'll hear back from the Laramie Dunn Team shortly. One follow-up, no spam.</p>
      <div class="mt-7 flex flex-wrap gap-3 justify-center">
        <Button href="/" variant="primary">Back home</Button>
        <Button href="/listings/" variant="ghost">See our listings</Button>
      </div>
    </div>
  </Section>
</Base>
