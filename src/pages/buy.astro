---
// buy.astro — buyers. Process, buyer-agreement explainer (generic, no commission figures), what to bring.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import LeadForm from "../components/LeadForm.astro";
import Icon from "../components/Icon.astro";
import { COUNTY } from "../config/site";

const steps = [
  { n: "1", h: "Talk first", b: "Tell us what you're looking for and where. We'll be honest about what's realistic in the current Tooele Valley market." },
  { n: "2", h: "Get set up", b: "If you'll need financing, we'll point you toward a lender so you know your numbers before you fall for a house." },
  { n: "3", h: "Sign the buyer agreement", b: "Before we tour homes, Utah has buyers sign a written buyer-broker agreement. We'll walk through it with you so it's clear." },
  { n: "4", h: "Tour and compare", b: "We show you homes, point out the things that photos hide, and help you weigh one against another." },
  { n: "5", h: "Write the offer", b: "When you find the one, we write a clean offer and negotiate on your behalf." },
  { n: "6", h: "Inspect and close", b: "We manage inspections, deadlines, and paperwork through to the day you get the keys." },
];
---
<Base
  breadcrumbs={[{ name: "Buying", href: "/buy/" }]}
  title="Buying a home in Tooele County"
  description="How buying works with the Laramie Dunn Team — the process, the written buyer agreement, and what to bring to get started in Tooele County, Utah."
  stickyCta={true}
>
  <Section tone="paper">
    <p class="text-[.72rem] uppercase tracking-[.14em] text-copper-dark font-semibold">Buying</p>
    <h1 class="mt-2 text-[clamp(1.8rem,6vw,2.6rem)] max-w-[720px]">Buying a home, without the guesswork.</h1>
    <p class="mt-4 text-lg leading-relaxed max-w-[680px]">Whether it's your first home or your fifth, the steps are the same and we'll be with you for each one. Here is how it goes.</p>
    <div class="mt-6"><Button href="#start" variant="primary">Start with a conversation <Icon name="arrow-right" size={16} /></Button></div>
  </Section>

  <Section tone="white" labelledby="steps-h">
    <h2 id="steps-h" class="text-[clamp(1.5rem,5vw,2rem)]">The process</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {steps.map((s) => (
        <Card>
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-copper text-white font-display">{s.n}</span>
          <p class="mt-3 font-display text-[1.2rem]">{s.h}</p>
          <p class="mt-2 text-muted text-[.95rem]">{s.b}</p>
        </Card>
      ))}
    </div>
  </Section>

  <Section tone="paper" narrow labelledby="agreement-h">
    <h2 id="agreement-h" class="text-[clamp(1.5rem,5vw,2rem)]">About the buyer agreement</h2>
    <div class="mt-4 space-y-4 text-[1.02rem] leading-relaxed">
      <p>In Utah, buyers now sign a written buyer-broker agreement before touring homes. It spells out who represents you, what we'll do for you, and how our work is paid for. It's a normal part of the process, not fine print to rush past.</p>
      <p>We go through it with you in plain language and answer every question before you sign anything. The numbers and terms are yours to review — nothing is assumed.</p>
    </div>
  </Section>

  <Section tone="white">
    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="text-[clamp(1.5rem,5vw,2rem)]">What to bring</h2>
        <ul class="mt-4 space-y-3 text-[1.02rem]">
          <li class="flex gap-3"><Icon name="check" size={20} class="text-copper-dark flex-none mt-1" /> A sense of the areas you're considering — we serve all of {COUNTY}.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="text-copper-dark flex-none mt-1" /> A rough budget, or a willingness to talk to a lender to find one.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="text-copper-dark flex-none mt-1" /> Your must-haves and your deal-breakers, honestly.</li>
          <li class="flex gap-3"><Icon name="check" size={20} class="text-copper-dark flex-none mt-1" /> Questions — the more the better.</li>
        </ul>
      </div>
      <div>
        <h2 class="text-[clamp(1.5rem,5vw,2rem)]">A note on the commute</h2>
        <p class="mt-4 text-[1.02rem] leading-relaxed">Most of the Tooele Valley connects to Salt Lake County to the northeast by way of State Route 36 and Interstate 80. Where you land in the valley changes that drive, so it's worth thinking about alongside the house itself. We can talk you through the tradeoffs town by town.</p>
        <div class="mt-5"><Button href="/communities/" variant="ghost">See the communities</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="panel" narrow id="start">
    <LeadForm src="buy" heading="Tell us what you're looking for" intent="buy" />
  </Section>
</Base>
