---
// StickyCta.astro — mobile-only sticky call bar, both agents. Hides when a LeadForm is on screen (IntersectionObserver).
import { AGENTS } from "../config/site";
import Icon from "./Icon.astro";
const [lisa, laramie] = AGENTS;
---
<aside aria-label="Quick contact">
<div
  id="sticky-cta"
  class="sticky-cta md:hidden fixed left-0 right-0 z-50 px-3 grid grid-cols-2 gap-2"
  style="bottom:max(10px,env(safe-area-inset-bottom));transform:translateY(170%);transition:transform .28s ease;"
>
  <a href={lisa.phoneHref} class="flex items-center justify-center gap-1.5 px-3 py-3 rounded-full bg-copper text-white text-[.88rem] font-bold no-underline whitespace-nowrap shadow-[0_7px_25px_rgba(0,0,0,.3)]"><Icon name="phone" size={15} /> Call or text Lisa</a>
  <a href={laramie.phoneHref} class="flex items-center justify-center gap-1.5 px-3 py-3 rounded-full bg-ink text-white text-[.88rem] font-bold no-underline whitespace-nowrap shadow-[0_7px_25px_rgba(0,0,0,.3)]"><Icon name="phone" size={15} /> Call Laramie</a>
</div>
</aside>

<script>
  const cta = document.getElementById("sticky-cta");
  if (cta) {
    const show = () => (cta.style.transform = "translateY(0)");
    const hide = () => (cta.style.transform = "translateY(170%)");
    let revealed = false;
    window.addEventListener("scroll", () => {
      if (!revealed && window.scrollY > 300) { revealed = true; show(); }
    }, { passive: true });
    const forms = document.querySelectorAll(".lead-form-root");
    if (forms.length && "IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        const anyVisible = entries.some((en) => en.isIntersecting);
        if (anyVisible) hide();
        else if (revealed) show();
      }, { threshold: 0.2 });
      forms.forEach((f) => io.observe(f));
    }
  }
</script>
