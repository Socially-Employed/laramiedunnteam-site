---
// FactStrip.astro — the 521 three-fact strip (grid 1.35fr 1fr 1fr).
export interface Props { items: { label: string; value?: string; lines?: { text: string; href?: string }[] }[]; stack?: boolean; }
// lines: optional stacked values (e.g. two agents' phone numbers), each optionally a tel: link.
const { items, stack = false } = Astro.props;   // stack: one column under 640px (long values)
---
<div class={`grid ${stack ? "grid-cols-1 sm:grid-cols-[1.35fr_1fr_1fr]" : "grid-cols-[1.35fr_1fr_1fr]"} bg-white border-b border-hairline`} aria-label="Key facts">
  {items.map((it, i) => (
    <div class={`min-w-0 px-1.5 py-4 text-center ${i > 0 ? (stack ? "border-t sm:border-t-0 sm:border-l border-hairline" : "border-l border-hairline") : ""}`}>
      {it.lines ? (
        it.lines.map((ln) => (
          <b class="block font-display text-[clamp(.98rem,4vw,1.2rem)] leading-snug text-copper-dark">
            {ln.href ? <a href={ln.href} class="text-copper-dark no-underline hover:underline">{ln.text}</a> : ln.text}
          </b>
        ))
      ) : (
        <b class="block font-display text-[clamp(1.02rem,4.5vw,1.35rem)] leading-tight text-copper-dark whitespace-nowrap">{it.value}</b>
      )}
      <span class="block mt-1 text-muted text-[.67rem] uppercase tracking-[.07em]">{it.label}</span>
    </div>
  ))}
</div>
