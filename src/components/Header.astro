---
// Header.astro — two-tier header: utility bar (secondary links + both agents' numbers) over the
// uppercase main nav. L6 Editorial Masthead horizontal lockup; RealtyPath is carried in the footer (every page).
import Icon from "./Icon.astro";
import { AGENTS } from "../config/site";

const primary = [
  { href: "/search/", label: "Search" },
  { href: "/communities/", label: "Communities" },
  { href: "/buy/", label: "Buyers" },
  { href: "/sell/", label: "Sellers" },
  { href: "/listings/", label: "Listings" },
  { href: "/contact/", label: "Contact" },
];
const utility = [
  { href: "/about/", label: "About the team" },
  { href: "/home-value/", label: "Home value" },
  { href: "/reviews/", label: "Reviews" },
  { href: "/faq/", label: "FAQ" },
];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="sticky top-0 z-40 bg-paper border-b border-hairline">
  <!-- Utility bar -->
  <div class="hidden md:block bg-ink text-paper text-[.78rem]">
    <div class="w-[min(100%,80rem)] mx-auto px-5 h-9 flex items-center justify-between gap-6">
      <ul class="flex items-center gap-5">
        {utility.map((l) => (
          <li><a href={l.href} class="no-underline text-paper/80 hover:text-white">{l.label}</a></li>
        ))}
      </ul>
      <ul class="flex items-center gap-5">
        {AGENTS.map((a) => (
          <li>
            <a href={a.phoneHref} class="inline-flex items-center gap-1.5 no-underline text-paper/90 hover:text-white font-semibold">
              <Icon name="phone" size={13} /> {`${a.name.split(" ")[0]} · ${a.phone}`}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Main row -->
  <div class="w-[min(100%,80rem)] mx-auto px-5 h-[72px] flex items-center justify-between gap-5">
    <a href="/" class="inline-flex items-center no-underline shrink-0" aria-label="Laramie Dunn Team home">
      <img src="/images/brand/ldt-horizontal.svg" alt="Laramie Dunn Team" width="571" height="92" class="w-[min(60vw,232px)] h-auto md:w-auto md:h-[40px] lg:h-[37px] xl:h-[40px] 2xl:h-[44px]" />
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-4 xl:gap-6 2xl:gap-7">
        {primary.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? "page" : undefined}
              class:list={[
                "no-underline uppercase tracking-[.12em] text-[.72rem] xl:text-[.76rem] font-semibold py-2 border-b-2 whitespace-nowrap",
                isActive(l.href) ? "text-copper-dark border-copper" : "text-ink border-transparent hover:text-copper-dark hover:border-hairline",
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/search/" class="hidden md:inline-flex lg:hidden items-center gap-2 no-underline text-ink font-semibold text-[.85rem]">Search homes</a>
      <details class="relative hidden md:block lg:hidden xl:block group shrink-0">
        <summary class="list-none cursor-pointer inline-flex items-center gap-2 min-h-[44px] px-4 rounded-[9px] bg-copper-dark text-white font-semibold text-[.9rem] whitespace-nowrap hover:bg-copper [&::-webkit-details-marker]:hidden">
          <Icon name="phone" size={16} /> Call the team <Icon name="chevron-down" size={14} />
        </summary>
        <ul class="absolute right-0 mt-2 w-[240px] rounded-[12px] border border-hairline bg-white p-2 shadow-lift">
          {AGENTS.map((a) => (
            <li>
              <a href={a.phoneHref} class="flex flex-col rounded-[8px] px-3 py-2 no-underline hover:bg-paper">
                <span class="font-semibold text-ink text-[.92rem]">{a.name}</span>
                <span class="text-copper-dark text-[.9rem]">{a.phone}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>

      <details class="relative lg:hidden">
        <summary class="list-none cursor-pointer inline-flex items-center justify-center w-11 h-11 rounded-[9px] border border-hairline text-ink [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <Icon name="menu" size={22} />
        </summary>
        <div class="fixed inset-x-0 top-[72px] md:top-[108px] bottom-0 z-40 overflow-y-auto bg-paper border-t border-hairline p-5">
          <nav aria-label="Mobile">
            <ul class="grid gap-1">
              {primary.map((l) => (
                <li><a href={l.href} class="block rounded-[9px] px-3 py-3 no-underline text-ink text-[1.05rem] font-semibold uppercase tracking-[.12em] hover:bg-white">{l.label}</a></li>
              ))}
              {utility.map((l) => (
                <li><a href={l.href} class="block rounded-[9px] px-3 py-2.5 no-underline text-muted text-[.95rem] hover:bg-white">{l.label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="mt-5 grid gap-3">
            {AGENTS.map((a, i) => (
              <a href={a.phoneHref} class:list={["inline-flex items-center justify-center gap-2 min-h-[50px] rounded-[9px] font-semibold no-underline text-white", i === 0 ? "bg-copper-dark" : "bg-ink"]}>
                <Icon name="phone" size={18} /> {`Call ${a.name.split(" ")[0]} · ${a.phone}`}
              </a>
            ))}
          </div>
          <p class="mt-5 text-[.8rem] text-muted">Laramie Dunn Team · RealtyPath LLC</p>
        </div>
      </details>
    </div>
  </div>
</header>
