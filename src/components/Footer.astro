---
// Footer.astro — brand string, agents' contact, Equal Housing Opportunity mark, brokerage line.
import { AGENTS, BRAND_STRING, COUNTY } from "../config/site";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
---
<footer class="bg-paper border-t border-hairline text-muted text-[.85rem]">
  <div class="w-[min(100%,72rem)] mx-auto px-5 py-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-[1fr_1.5fr_1fr]">
      <div>
        <p class="font-display text-[1.15rem] text-ink">Laramie Dunn Team</p>
        <p class="mt-1">{BRAND_STRING}</p>
        <p class="mt-3">Serving {COUNTY}</p>
      </div>

      <div>
        <p class="font-semibold text-ink mb-2">Contact</p>
        {AGENTS.map((a) => (
          <p class="leading-7">
            <span class="text-ink font-medium whitespace-nowrap">{a.name}</span> ·
            <a href={a.phoneHref} class="text-copper-dark no-underline hover:underline whitespace-nowrap"> {a.phone}</a> ·
            <a href={`mailto:${a.email}`} class="text-copper-dark no-underline hover:underline whitespace-nowrap"> {a.email}</a>
            {a.licenseNumber && <span class="block text-[.8rem]">UT License #{a.licenseNumber}</span>}
          </p>
        ))}
      </div>

      <div>
        <p class="font-semibold text-ink mb-2">Equal Housing</p>
        <div class="flex items-center gap-3">
          <svg width="40" height="40" viewBox="0 0 40 40" role="img" aria-label="Equal Housing Opportunity" class="flex-none text-ink">
            <rect x="1.5" y="1.5" width="37" height="37" rx="3" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M20 8 L31 17 L28.5 17 L28.5 28 L11.5 28 L11.5 17 L9 17 Z" fill="currentColor"/>
            <rect x="14" y="30.5" width="12" height="2.2" fill="currentColor"/>
            <rect x="14" y="34.2" width="12" height="2.2" fill="currentColor"/>
          </svg>
          <span>Equal Housing Opportunity</span>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-hairline space-y-2">
      <p>Laramie Dunn Team is a team of licensed Utah real estate agents with RealtyPath LLC.</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href="/privacy" class="text-copper-dark no-underline hover:underline">Privacy</a>
        <span>&copy; {year} Laramie Dunn Team</span>
      </p>
    </div>
  </div>
</footer>
