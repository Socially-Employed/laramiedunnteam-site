---
// Hero.astro — full-bleed image hero with eyebrow/title/lede + ctas slot.
export interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  image?: { src: string; alt: string; width: number; height: number };
}
const { eyebrow, title, lede, image } = Astro.props;
---
<header class="relative grid min-h-[560px] md:min-h-[640px] overflow-hidden bg-ink text-white [&>*]:[grid-area:1/1]">
  {image && (
    <img
      class="w-full h-full object-cover object-[center_60%] min-h-[560px] md:min-h-[640px]"
      src={image.src}
      alt={image.alt}
      width={image.width}
      height={image.height}
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="z-[1] bg-gradient-to-b from-black/25 via-black/40 to-black/80" aria-hidden="true"></div>
  <div class="z-[2] self-end w-[min(100%,72rem)] mx-auto px-5 pb-12 md:pb-[70px] pt-10">
    {eyebrow && (
      <p class="inline-block mb-3 px-3 py-1.5 rounded-full bg-copper text-[.77rem] font-bold uppercase tracking-[.06em]">{eyebrow}</p>
    )}
    <h1 class="max-w-[820px] text-[clamp(2rem,7vw,3.6rem)] leading-[1.08] tracking-[-.03em] text-balance">{title}</h1>
    {lede && <p class="max-w-[720px] mt-4 text-paper/90 text-[1.02rem]">{lede}</p>}
    <div class="mt-6 flex flex-wrap gap-3">
      <slot name="ctas" />
    </div>
  </div>
</header>
