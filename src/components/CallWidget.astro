---
// CallWidget.astro — desktop sticky "questions? call or text" card, bottom-right.
// Mobile keeps StickyCta (the two-button bar). Dismissable for the session.
import Icon from "./Icon.astro";
import { AGENTS } from "../config/site";
---
<aside class="call-widget hidden md:block fixed bottom-5 right-5 z-30 w-[260px] rounded-[12px] border border-hairline bg-white shadow-lift" data-widget>
  <div class="flex items-start justify-between gap-2 px-4 pt-3">
    <p class="font-display text-[1.05rem] text-ink leading-tight">Do you have questions?<br /><span class="text-copper-dark">Call or text.</span></p>
    <button type="button" class="call-widget-close -mr-1 -mt-1 inline-flex w-8 h-8 items-center justify-center rounded-full text-muted hover:bg-paper" aria-label="Hide">
      <Icon name="x" size={16} />
    </button>
  </div>
  <ul class="px-4 pb-4 pt-2 space-y-2">
    {AGENTS.map((a) => (
      <li>
        <a href={a.phoneHref} class="flex items-center gap-2 rounded-[9px] border border-hairline px-3 py-2 no-underline hover:border-copper">
          <Icon name="phone" size={16} class="text-copper-dark" />
          <span class="text-[.9rem]"><span class="font-semibold text-ink">{a.name.split(" ")[0]}</span> <span class="text-copper-dark">{a.phone}</span></span>
        </a>
      </li>
    ))}
  </ul>
</aside>
<script>
  const w = document.querySelector<HTMLElement>("[data-widget]");
  if (w) {
    try { if (sessionStorage.getItem("ldt_cw") === "1") w.hidden = true; } catch {}
    w.querySelector(".call-widget-close")?.addEventListener("click", () => {
      w.hidden = true;
      try { sessionStorage.setItem("ldt_cw", "1"); } catch {}
    });
  }
</script>
