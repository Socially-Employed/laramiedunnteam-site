---
// Button.astro — variants: primary (copper) | ghost | dark. Renders <a> if href, else <button>.
export interface Props {
  href?: string;
  variant?: "primary" | "ghost" | "dark";
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: any;
}
const { href, variant = "primary", type = "button", class: cls = "", ...rest } = Astro.props;

const base =
  "inline-flex items-center justify-center gap-2 min-h-[50px] px-[22px] py-3 rounded-[9px] font-semibold text-center no-underline cursor-pointer transition-colors";
const variants: Record<string, string> = {
  primary: "bg-copper text-white hover:bg-copper-dark shadow-[0_8px_24px_rgba(0,0,0,.18)]",
  ghost: "bg-transparent text-copper-dark border border-hairline hover:bg-hairline/40",
  dark: "bg-ink text-white hover:bg-panel",
};
const klass = `${base} ${variants[variant]} ${cls}`;
const Tag = href ? "a" : "button";
---
{href ? (
  <a href={href} class={klass} {...rest}><slot /></a>
) : (
  <button type={type} class={klass} {...rest}><slot /></button>
)}
